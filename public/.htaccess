Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Do not rewrite real files or directories (js, css, images, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # All app routes (/memberCgt, /loan-plan, ...) → index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Hostinger fallback if rewrite is unavailable
ErrorDocument 404 /index.html
